# Mluona IPTV Backend Environment Configuration
PORT=3000
NODE_ENV=production

# Security Keys (Required in production - server will abort startup if missing)
JWT_SECRET=your_strong_random_jwt_secret_here_change_in_production
AES_SECRET_KEY=your_32_bytes_aes_key_here_123456789
SERVER_SALT=mluona_tv_device_salt_998877

# Admin Credentials (Hashed on initialization using bcrypt)
ADMIN_EMAIL=admin@mluona.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Restricted CORS Domains (comma-separated, file:// and null allowed for Smart TV)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mluona-iptv.com

# PostgreSQL Database (Optional - falls back to persistent storage if empty)
# DATABASE_URL=postgresql://user:password@localhost:5432/mluona_db
